<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast isolated tests: business rules, state machine, validators. No database. -->

  <PropertyGroup>
    <!-- xUnit v3 test projects are standalone executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reservo.Domain\Reservo.Domain.csproj" />
    <ProjectReference Include="..\..\src\Reservo.Application\Reservo.Application.csproj" />
  </ItemGroup>

</Project>
