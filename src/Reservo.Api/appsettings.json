{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/reservo-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "reservo",
    "Audience": "reservo",
    "AccessTokenMinutes": 30
  },
  "Booking": {
    "SlotStepMinutes": 15,
    "MinDurationMinutes": 15,
    "DefaultMaxDurationMinutes": 240,
    "MaxAdvanceDays": 30,
    "MaxActiveBookingsPerUser": 5
  },
  "Site": {
    "TimeZone": "Europe/Moscow"
  },
  "Seed": {
    "Admin": {
      "Email": "admin@reservo.example",
      "FullName": "Администратор"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
