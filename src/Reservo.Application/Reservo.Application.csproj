<Project Sdk="Microsoft.NET.Sdk">

  <!-- Слой приложения: сервисы сценариев, DTO, валидаторы, абстракции. -->

  <PropertyGroup>
    <!-- XML-комментарии к DTO попадают в Swagger. Отсутствие комментария не считается предупреждением. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Только ради DbSet<T> и асинхронных LINQ-операторов; провайдер PostgreSQL живёт в Infrastructure (PROJECT.md, 8.2). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reservo.Domain\Reservo.Domain.csproj" />
  </ItemGroup>

</Project>
