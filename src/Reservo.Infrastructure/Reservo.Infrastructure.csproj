<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure layer: EF Core and PostgreSQL, JWT, background jobs. Implements Application abstractions. -->

  <ItemGroup>
    <!-- ASP.NET Core shared framework: password hasher, options, hosting. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Brings Microsoft.IdentityModel.JsonWebTokens in the same version the API uses to validate tokens. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reservo.Application\Reservo.Application.csproj" />
  </ItemGroup>

</Project>
