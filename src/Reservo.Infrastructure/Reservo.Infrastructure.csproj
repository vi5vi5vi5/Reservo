<Project Sdk="Microsoft.NET.Sdk">

  <!-- Инфраструктурный слой: EF Core и PostgreSQL, JWT, фоновые задачи. Реализует абстракции слоя Application. -->

  <ItemGroup>
    <!-- Общий фреймворк ASP.NET Core: хешер паролей, options, хостинг. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Подтягивает Microsoft.IdentityModel.JsonWebTokens той же версии, которой API проверяет токены. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reservo.Application\Reservo.Application.csproj" />
  </ItemGroup>

</Project>
