# Скопируйте в .env (cp .env.example .env) и задайте свои значения. Файл .env игнорируется Git.
# Для локальной разработки (`docker compose up -d db` + запуск API из Visual Studio) .env не нужен:
# у базы в docker-compose.yml есть значения по умолчанию.

# --- База данных ---
POSTGRES_DB=reservo
POSTGRES_USER=reservo
# На сервере обязательно задайте свой пароль. Только латиница и цифры: он подставляется в строку подключения,
# где символ «;» разделяет параметры.
POSTGRES_PASSWORD=reservo_dev
POSTGRES_PORT=5433

# --- API в Docker ---
# Ключ подписи JWT, не короче 32 символов. Без него API не запустится. Сгенерировать: openssl rand -base64 48
JWT_KEY=
# Пароль администратора admin@reservo.example. Пусто — администратор не создаётся.
ADMIN_PASSWORD=
# Пароль демо-пользователей student@, teacher@ и student2@reservo.example. Пусто — без демо-пользователей и демо-броней.
DEMO_USER_PASSWORD=
# 127.0.0.1 — API доступен только с этой машины; 0.0.0.0 — доступен снаружи по адресу http://<ip сервера>:<API_PORT>.
API_BIND=127.0.0.1
API_PORT=8080
# Версия образа: latest или тег вида sha-1a2b3c4 из GitHub Container Registry (чтобы откатиться на прошлую сборку).
API_TAG=latest
