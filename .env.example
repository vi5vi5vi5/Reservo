# Скопируйте в .env, чтобы переопределить значения по умолчанию из docker-compose.yml.
# Файл .env игнорируется Git. Значения ниже подходят только для локальной разработки:
# на сервере обязательно задайте надёжный POSTGRES_PASSWORD.

POSTGRES_DB=reservo
POSTGRES_USER=reservo
POSTGRES_PASSWORD=reservo_dev
POSTGRES_PORT=5433
